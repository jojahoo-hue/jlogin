# Copier ce fichier en .env et remplir les valeurs
# Ne jamais commiter le fichier .env (il est dans .gitignore)

# Notion
NOTION_TOKEN=secret_xxxx_REMPLACER_PAR_TON_TOKEN

# Archivage Notes Apple -> Notion
# Id de la base "Archives Notes Apple" (cree avec : python3 scripts/apple-notes-to-notion.py --create-db)
NOTION_NOTES_DB_ID=REMPLACER_PAR_ID_BASE_NOTES
# Page Notion qui hebergera la base, utile uniquement pour --create-db
NOTION_NOTES_PARENT_PAGE_ID=REMPLACER_PAR_ID_PAGE_PARENTE

# Telegram Bot (depuis @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=REMPLACER_PAR_TON_TOKEN_BOT

# Ton Chat ID Telegram (envoyer un message à @userinfobot pour l'obtenir)
TELEGRAM_CHAT_ID=REMPLACER_PAR_TON_CHAT_ID

# Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-REMPLACER_PAR_TA_CLE
